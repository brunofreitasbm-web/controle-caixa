# Configurações de SMTP para Envio de Notificações de Envelope
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# String de conexão Postgres (Supabase). Se não definida, o app cai
# automaticamente para SQLite local (database.db) — ver config/database.js.
DATABASE_URL=

# Secret do header "Authorization: Bearer <valor>" que o Make.com usa para
# chamar POST /api/pos-visita/importar. Precisa do MESMO valor configurado
# como variável de ambiente no Render (ver docs/prompt-make-pos-visita.md).
POS_VISITA_IMPORT_SECRET=

# Secret do header "Authorization: Bearer <valor>" para os endpoints de cron
# (/api/cron/ia-tick, /api/cron/backup-mensal). Ver vercel.json e o pinger
# externo documentado em docs/IA.md.
CRON_SECRET=

# Porta HTTP local (default: 5000 se não definida — ver server.js)
PORT=

# ==========================================================================
# IA (services/ia.js)
# ==========================================================================
# Provedor ativo: gemini | groq | openrouter. Trocar aqui troca o provedor
# em todo o sistema, sem mexer em nenhuma rota.
IA_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Espacamento minimo entre chamadas, em ms. A camada gratuita limita
# requisicoes por minuto; disparar um lote de mensagens de uma vez
# estouraria a cota. 4000ms = ~15 chamadas/min.
IA_INTERVALO_MS=4000
IA_TIMEOUT_MS=30000
IA_THINKING_BUDGET=

# Chave de escape: true desliga a IA e faz todo o sistema usar os fallbacks.
IA_DESATIVADA=false

# Postgres via Supabase: setar como "false" apenas se o certificado do
# pooler exigir (não recomendado desligar em produção).
DB_SSL_REJECT_UNAUTHORIZED=
